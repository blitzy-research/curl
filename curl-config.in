###########################################################################

# HOW THIS FILE IS RENDERED BY THE CARGO PRODUCT BUILD
#
# This is the curl-config template, and it now has three renderers rather
# than two. Autotools substitutes it through AC_SUBST and config.status --
# configure.ac:5476 is AC_CONFIG_FILES([curl-config], [chmod +x
# curl-config]) -- and CMake substitutes it with configure_file() in @ONLY
# mode at CMakeLists.txt:2295-2297, installing the result with executable
# permissions. Both of those remain in the tree and remain exercised,
# because the C build is retained as the reference oracle this rewrite is
# measured against; what changed is that neither of them renders the
# PRODUCT any more.
#
# The product renderer is curl-rs-ffi/build.rs, and a Cargo build runs
# neither Autotools nor CMake to reach it: the build script reads this
# file, fills in the eighteen substitution tokens and writes
# bin/curl-config, mode 0755, into an install-staging directory under
# target/ -- or wherever CURL_RS_STAGING_DIR names, and never into the
# checkout.
#
# The command-line contract is frozen: the option spellings usage() lists
# below, the shape of what each prints and the exit status each leaves are the
# ones curl 8.x published, because third-party build systems shell out to
# curl-config and parse the answer. Nothing is added either.
#
# The features and protocols this script prints are projections of the
# capability table in curl-rs-lib/src/version.rs, which also renders the
# `curl --version` banner, so this script, libcurl.pc and that banner cannot
# describe three different products.

# shellcheck disable=SC2006

prefix='@prefix@'
# Used in 'libdir'
# shellcheck disable=SC2034
exec_prefix="@exec_prefix@"
# shellcheck disable=SC2034
includedir="@includedir@"

usage()
{
  cat <<EOF
Usage: curl-config [OPTION]

Available values for OPTION include:

  --built-shared        says 'yes' if libcurl was built shared
  --ca                  CA bundle install path
  --cc                  compiler
  --cflags              preprocessor and compiler flags
  --checkfor [version]  check for (lib)curl of the specified version
  --configure           the arguments given to configure when building curl
  --features            newline separated list of enabled features
  --help                display this help and exit
  --libs                library linking information
  --prefix              curl install prefix
  --protocols           newline separated list of enabled protocols
  --ssl-backends        output the SSL backends libcurl was built to support
  --static-libs         static libcurl library linking information
  --version             output version information
  --vernum              output version as a hexadecimal number
EOF

  exit "$1"
}

if test "$#" -eq 0; then
  usage 1
fi

while test "$#" -gt 0; do
  case "$1" in
  # ENABLE_SHARED expands to yes: curl-rs-ffi declares both crate types under
  # [lib] name = "curl", so both artifacts really are called libcurl. The
  # shared object's DT_SONAME = libcurl.so.4 is derived, not chosen --
  # lib/Makefile.soname gives libtool -version-info 12:0:8, and a libtool
  # soname major is current - age.
  --built-shared)
    echo '@ENABLE_SHARED@'
    ;;

  # The runtime CA bundle path, where empty is a legitimate answer rather than
  # an oversight: trust anchors come through rustls unless a path is
  # configured. It is NOT the bundle curl-rs/build.rs embeds into the
  # command-line tool, which is compiled in and so has no path to report.
  --ca)
    echo '@CURL_CA_BUNDLE@'
    ;;

  # CC answers the question the option is really asked -- what compiler can
  # build a program against this artifact -- so it names a C compiler for the
  # target that was built, not the Rust toolchain that built libcurl. The
  # precedence is cc-rs's: CC_<target>, its underscored spelling, TARGET_CC,
  # CC, then a name derived from the triple. That order matters when
  # cross-compiling, where a bare CC would name the host compiler. It is never
  # empty: a consumer substituting an empty value into a command line would
  # run its next argument as a program.
  --cc)
    echo '@CC@'
    ;;

  --prefix)
    echo "$prefix"
    ;;

  # Each name is spelled as configure.ac spells it, and the list is sorted
  # case-insensitively as CMakeLists.txt:2040-2045 sorts it, so two builds of
  # one configuration print the same lines in the same order.
  #
  # Truthfulness here is the optimal strategy and not merely the decent
  # one. tests/runtests.pl parses the Features: line of `curl --version`
  # into a 52-name map, and 874 of the 1,914 fixtures gate on it, so
  # under-reporting a capability only makes a fixture skip while
  # over-reporting makes it run and fail. Withheld on purpose:
  #
  #   Debug, and with it TrackMemory -- advertising Debug arms the
  #   harness's allocation-cap and leak accounting against a Rust
  #   allocator whose allocation pattern cannot match a C one. The cost is
  #   stated rather than hidden: 98 fixtures skip and torture-test does
  #   not apply.
  #
  #   Every name belonging to a dropped backend, since rustls, quinn and
  #   russh are the sole implementations: MultiSSL, OpenSSL, GnuTLS,
  #   mbedtls, wolfssl, Schannel, SSPI, TLS-SRP, NTLM_WB, WinIDN,
  #   AppleIDN, libssh, libssh2, c-ares and gsasl.
  #
  #   ...but NOT GSS-API, SPNEGO or Kerberos. Those three are compiled in
  #   only behind the non-default `negotiate` Cargo feature, and when they
  #   are compiled in this script names them -- because `--features` asks
  #   what this libcurl was BUILT to do, and that is the question the
  #   feature gate already decides. C answers it the same way:
  #   configure.ac:5175-5200 appends the three names to SUPPORT_FEATURES
  #   from HAVE_GSSAPI, a build-time fact it never re-examines.
  #
  #   Whether a usable mechanism exists on the HOST is a different
  #   question, and it is genuinely a runtime one that a script written at
  #   build time cannot answer. It is left to `curl --version`, which can
  #   ask, and whose banner conjoins that probe before naming the token.
  #   Only the banner is read by tests/runtests.pl, so the two surfaces
  #   answering two different questions costs no fixture anything.
  #
  # The list is not written down here. It is read from the capability
  # table in curl-rs-lib/src/version.rs, the same table libcurl.pc's
  # supported_features and the runtime banner are read from, so the three
  # agree by construction rather than by inspection. A capability appears
  # only once the engine module that provides it is present, so the list
  # is never ahead of the code.
  #
  # That rule bites hard at this checkpoint, and the consequence is stated
  # rather than left for a consumer to discover: most engine rows are still
  # absent, so the rendered value is short -- IDN, Largefile and threadsafe
  # at the time of writing. Do not trust that as a current reading. Render
  # the file and ask it, which is the only answer that cannot be stale:
  #   ./curl-config --features
  --feature|--features)
    for feature in @SUPPORT_FEATURES@ ''; do
      test -n "$feature" && echo "$feature"
    done
    ;;

  # SUPPORT_PROTOCOLS expands to the schemes this build really serves,
  # space separated so the loop below word-splits it into one scheme per
  # line. The TARGET SCOPE is nine schemes and no more -- FILE FTP FTPS
  # HTTP HTTPS SCP SFTP WS WSS -- but scope is not the expansion. The
  # expansion is whatever the capability table reports as served, and
  # measured at this checkpoint that is NONE of the nine: no scheme has a
  # protocol executor yet. So the variable currently expands to the EMPTY
  # string and `curl-config --protocols` prints nothing at all -- the loop
  # runs zero times, which is why it is written to tolerate that rather
  # than assuming at least one item. It becomes the nine, without an edit
  # here, as each executor lands.
  #
  # IPFS AND IPNS ARE NOT LIBRARY PROTOCOLS AND NEVER APPEAR HERE. The curl
  # TOOL hard-codes those two tokens itself (src/tool_libinfo.c:47-48,
  # carried in curl-rs/src/cli/libinfo.rs) and inserts them into the
  # Protocols: line of `curl --version` so that a gateway URL can be
  # translated on the command line. The engine has no ipfs scheme and no
  # ipns scheme: neither is one of the 33 rows it registers, so a library
  # consumer cannot request one. This option and libcurl.pc report the
  # ENGINE, so both stay silent about them however the tool's banner
  # eventually reads. A build system that greps here for ipfs is asking the
  # wrong surface.
  #
  # The twenty-four schemes that stay registered for ABI completeness but
  # are not implemented -- DICT, GOPHER, GOPHERS, IMAP, IMAPS, LDAP, LDAPS,
  # MQTT, MQTTS, POP3, POP3S, RTMP and its variants, RTSP, SMB, SMBS, SMTP,
  # SMTPS, TELNET and TFTP -- are deliberately absent, and the absence is
  # the point rather than an oversight. MQTTS belongs in that list beside
  # MQTT: the registry carries both mqtt and mqtts, and naming only one
  # would leave the enumeration short of the twenty-four it counts. They
  # are out of scope for implementation but not for the ABI, so their
  # CURLPROTO_ constants remain in the public header, a request for one of
  # them is specified to return CURLE_UNSUPPORTED_PROTOCOL, and 283
  # fixtures -- 14.8% of the corpus -- depend on this omission to skip
  # cleanly instead of running and failing. These twenty-four stay absent
  # permanently, which is what distinguishes them from the nine above:
  # those nine are withheld only until their engine lands.
  #
  # The upper case is curl's own, not a choice made here:
  # configure.ac:5326 onward appends HTTP, FTP, FILE and the rest
  # upper-cased, and CMakeLists.txt:1994 builds the same variable from
  # upper-case items, deriving a separate lower-case one at :1995 purely
  # for a status message. The engine stores these schemes in lower case
  # for the Protocols: line of `curl --version`, so one list serves both
  # surfaces and the renderer applies that documented transformation.
  --protocols)
    # shellcheck disable=SC2043
    for protocol in @SUPPORT_PROTOCOLS@; do
      echo "$protocol"
    done
    ;;

  # LIBCURL_VERSION of include/curl/curlver.h, read as configure.ac:129 read
  # it. It is not bumped: the version is part of the frozen ABI contract, and
  # every parity claim about this artifact is a claim against it.
  --version)
    echo 'libcurl @CURLVERSION@'
    exit 0
    ;;

  # Reproduced rather than rewritten. It already tolerates a development
  # version: the cut -d- -f1 on the patch field turns a -DEV suffix into 0,
  # which is what lets the comparison run at all. A requested version equal to
  # or older than this one exits 0 and prints nothing; a newer one prints the
  # sentence below on stdout and exits 1.
  --checkfor)
    checkfor="$2"
    cmajor=`echo "$checkfor" | cut -d. -f1`
    cminor=`echo "$checkfor" | cut -d. -f2`
    # when extracting the patch part we strip off everything after a
    # dash as that's used for things like version 1.2.3-pre1
    cpatch=`echo "$checkfor" | cut -d. -f3 | cut -d- -f1`

    vmajor=`echo '@CURLVERSION@' | cut -d. -f1`
    vminor=`echo '@CURLVERSION@' | cut -d. -f2`
    # when extracting the patch part we strip off everything after a
    # dash as that's used for things like version 1.2.3-pre1
    vpatch=`echo '@CURLVERSION@' | cut -d. -f3 | cut -d- -f1`

    if test "$vmajor" -gt "$cmajor"; then
      exit 0
    fi
    if test "$vmajor" -eq "$cmajor"; then
      if test "$vminor" -gt "$cminor"; then
        exit 0
      fi
      if test "$vminor" -eq "$cminor"; then
        if test "$cpatch" -le "$vpatch"; then
          exit 0
        fi
      fi
    fi

    echo "requested version $checkfor is newer than existing @CURLVERSION@"
    exit 1
    ;;

  # The hexadecimal digits of LIBCURL_VERSION_NUM with the 0x dropped, because
  # the sed at configure.ac:141 captured only the digits: a consumer parsing
  # this output has always received them bare.
  --vernum)
    echo '@VERSIONNUM@'
    exit 0
    ;;

  --help)
    usage 0
    ;;

  # LIBCURL_PC_CFLAGS expands to empty and the -I is appended below, so this
  # arm's output shape is unchanged. The directory reported is the one HOLDING
  # curl/, not curl/ itself, since the headers are included as <curl/curl.h>.
  # The header found there is generated: cbindgen, run from
  # curl-rs-ffi/build.rs, produces include/curl/curl.h from the ABI crate, and
  # include/curl/typecheck-gcc.h ships verbatim beside it as a hand-maintained
  # file because its curlcheck_ macros cannot be expressed by cbindgen.
  --cflags)
    if test "@includedir@" = '/usr/include'; then
      echo '@LIBCURL_PC_CFLAGS@'
    else
      echo "@LIBCURL_PC_CFLAGS@ -I@includedir@"
    fi
    ;;

  # -lcurl is the one literal in this file that must never change, and
  # curl-rs-ffi earns it by declaring [lib] name = "curl", so the artifacts
  # really are libcurl.so and libcurl.a.
  #
  # LIBCURL_PC_LIBS_PRIVATE, printed only when the shared library was not
  # built, is no more than the platform C runtime, plus the GSS library when
  # the negotiate feature is on. Nothing else appears: every C library curl
  # used to name is now a statically linked Rust crate, and the pinned
  # cryptographic provider compiles its C and assembly into the archive, so
  # there is no external library left to name.
  --libs)
    if test "@libdir@" != '/usr/lib' && test "@libdir@" != '/usr/lib64'; then
      curllibdir="-L@libdir@ "
    else
      curllibdir=''
    fi
    if test '@ENABLE_SHARED@' = 'no'; then
      echo "${curllibdir}-lcurl @LIBCURL_PC_LIBS_PRIVATE@"
    else
      echo "${curllibdir}-lcurl"
    fi
    ;;

  # rustls and nothing else, because there is no C TLS library at any
  # configuration. No value had to be invented: CURLSSLBACKEND_RUSTLS = 14
  # already exists in curl_sslbackend, so curl_global_sslset reports a backend
  # the public header has always declared.
  #
  # The spelling is deliberate. tests/runtests.pl sets its rustls feature from
  # a rustls-ffi token in the libcurl banner, so emitting rustls-ffi here
  # would unlock the rustls-gated fixtures while misdescribing an
  # implementation that uses rustls natively rather than through its C FFI;
  # the skips are accepted instead. The lower case is the crate's own, where
  # CMakeLists.txt:2055-2062 capitalises its backend names.
  --ssl-backends)
    echo '@SSL_BACKENDS@'
    ;;

  # ENABLE_STATIC expands to yes and libext to a, because the staticlib crate
  # type produces libcurl.a. The disabled branch is kept rather than removed
  # as unreachable: reporting the refusal on stderr and exiting 1 is part of
  # this option's contract, and a consumer's configure script may test for
  # that pair.
  #
  # LIBCURL_PC_LDFLAGS_PRIVATE expands to empty, and LIBCURL_PC_LIBS_PRIVATE
  # is the same native-link set as the --libs arm above, read from the same
  # authority so the two options cannot disagree. Its order is the one a
  # left-to-right static linker needs, which is why -lc is last. A Rust
  # staticlib is not self-contained -- it carries no reference to the Rust
  # standard library's own dependencies -- so a consumer that omits these gets
  # undefined symbols rather than a diagnosis.
  --static-libs)
    if test '@ENABLE_STATIC@' != 'no'; then
      echo "@libdir@/libcurl.@libext@ @LIBCURL_PC_LDFLAGS_PRIVATE@ @LIBCURL_PC_LIBS_PRIVATE@"
    else
      echo 'curl was built with static libraries disabled' >&2
      exit 1
    fi
    ;;

  # There is no configure left to give arguments to, so CONFIGURE_OPTIONS
  # holds the equivalent Cargo invocation -- the target triple and the enabled
  # feature list, as --target=<triple> --features=<a,b,c> -- which still
  # answers the question the option is really asked. CMakeLists.txt:2077 left
  # this empty. The option itself stays, because the command-line surface is
  # frozen and only the value behind it moved.
  --configure)
    echo @CONFIGURE_OPTIONS@
    ;;

  *)
    echo "unknown option: $1"
    usage 1
    ;;
  esac
  shift
done

exit 0
